// Deploys the built site to Cloudflare as a Worker serving static assets, which Cloudflare
// recommends over Pages for new projects. There is no Worker script: every request is a
// file under build/public, so the site_dir Zensical writes is the whole deployment.
// The Site workflow runs `wrangler deploy` on main and `wrangler versions upload` for a
// pull request's preview; see .github/workflows/site.yml.
{
  "name": "awesome-humans",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": "./build/public",
    // Zensical writes a 404.html; serve it with a 404 status for any unknown path.
    "not_found_handling": "404-page",
    // Pages are directories with an index.html, so /dotnet/ and /dotnet both resolve.
    "html_handling": "auto-trailing-slash",
  },
  // wrangler deploy creates the DNS record and certificate for each custom domain.
  "routes": [{ "pattern": "awesome-humans.net", "custom_domain": true }],
  // No public workers.dev copy of the site, but keep the per-version preview URLs that
  // pull request previews are served from.
  "workers_dev": false,
  "preview_urls": true,
}
