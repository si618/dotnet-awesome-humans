<!-- Test project on Microsoft.Testing.Platform with xUnit v3. `dotnet test` runs it via the
     runner opt-in in global.json; no TestingPlatformDotnetTestSupport, which is the VSTest
     bridge that MTP v2 (xunit.v3 4.0.0) rejects on the .NET 10 SDK. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Keep solution-level publish deploy-only: without this the test host and a second copy
         of every referenced library land in artifacts/publish (opinions/ci.md). -->
    <IsPublishable>false</IsPublishable>
    <!-- Required: xunit.v3 test projects build to a self-contained executable under
         Microsoft.Testing.Platform, and the build errors out without this. -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- CA1707 (no underscores in member names) contradicts the house test-naming
         convention UnitOfWork_Scenario_ExpectedBehaviour (opinions/testing.md). The
         convention wins in test projects; CA1707 still applies to shipping code. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <ProjectReference Include="../../src/Example.Library/Example.Library.csproj" />
  </ItemGroup>

</Project>
