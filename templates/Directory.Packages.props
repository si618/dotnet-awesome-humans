<!-- dotnet-awesome-humans template | targets: net10.0 | last-reviewed: 2026-08-21 | last-used: 2026-08-20 | sources: ms-learn, dotnet-blog, meziantou -->
<!-- Central Package Management: every PackageReference in the repo takes its version from here. -->
<!-- Versions verified against nuget.org (latest stable) on 2026-08-21 — refresh via the refresh-dotnet-versions skill. -->
<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Framework extensions">
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.Validation" Version="10.0.11" />
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.2" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageVersion Include="Asp.Versioning.OpenApi" Version="10.2.2" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.159" />
  </ItemGroup>

  <!-- No Microsoft.Testing.Platform entry: xunit.v3 carries its own compatible
       version, and pinning MTP separately overrides it via transitive pinning and
       fails at runtime with a TypeLoadException (opinions/testing.md). This matters
       more since xunit.v3 4.0.0, which dropped MTP v1 and defaults to v2. -->
  <ItemGroup Label="Testing">
    <PackageVersion Include="bunit" Version="2.9.0" />
    <PackageVersion Include="Meziantou.Framework.SnapshotTesting" Version="3.0.2" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

</Project>
