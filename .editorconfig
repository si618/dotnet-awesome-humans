# This repository's own editor config, per the opinion in
# opinions/project-structure.md ("every repository carries a root .editorconfig").
#
# It is NOT the template — templates/.editorconfig is the canonical file shipped
# to consumers, and it carries the C#/F# house style. This one governs the prose
# and configuration that this repository actually contains. Keep the two separate:
# editing this file changes how we work, editing the template changes our advice.
#
# Values here match what `npm run format` (prettier) produces, so the editor and
# the formatter agree rather than fighting across saves.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Markdown: two trailing spaces are a hard line break, so trimming them silently
# changes rendered output. prettier preserves them; the editor must too.
# indent_size is unset because markdown nesting is content, not indentation —
# an ordered-list continuation lines up under "1. " at three columns, and any
# fixed multiple would flag prettier's own correct output.
[*.md]
trim_trailing_whitespace = false
indent_size = unset

[*.{json,jsonc,yml,yaml,toml}]
indent_size = 2

# MSBuild and solution files under templates/ — templates/.editorconfig is
# root = true and governs them, but these settings apply to any such file added
# elsewhere in the repository.
[*.{props,targets,csproj,fsproj,slnx,slnf,config}]
indent_size = 2

# C#: the repository now contains some of its own, under scripts/ — the CI checks.
# Only the layout lives here; the house C#/F# style is templates/.editorconfig, which
# the scripts follow. Duplicating those rules into this file would let the two drift.
[*.cs]
indent_size = 4

# Verbatim third-party text — the Apache 2.0 licence is reproduced exactly as
# published, indentation included. Never reformat it.
[LICENSE]
indent_size = unset
indent_style = unset
