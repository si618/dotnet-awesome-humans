# Build artifacts from smoke-testing the example projects in templates/
artifacts/
bin/
obj/

# A repo-local SDK from an sdk.paths trial (`dotnet-install --install-dir
# .dotnet`). A build prerequisite rather than build output, so the SDK's own
# gitignore template never covers it — see opinions/project-structure.md.
.dotnet/

# IDE and OS noise
.vs/
.idea/
*.user
.DS_Store

# Markdown tooling (package.json) — devDependencies only, not shipped
node_modules/

# Local harness skill discovery: a symlink to skills/ for a harness that only
# looks under its own directory. See AGENTS.md: Skills.
.claude/

# lychee link-check result cache
.lycheecache
